    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "express": "^4.19.2",
    "cookie-parser": "^1.4.6",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
